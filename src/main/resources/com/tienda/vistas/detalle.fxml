<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tienda.controlador.DetalleController"
      spacing="24" styleClass="contenido">
    <StackPane fx:id="contenedorImagen"/>

    <VBox spacing="10" prefWidth="340">
        <Label fx:id="nombre" styleClass="title-2" wrapText="true"/>
        <Label fx:id="categoria" styleClass="text-muted"/>
        <Label fx:id="descripcion" wrapText="true"/>
        <Label fx:id="precio" styleClass="precio"/>
        <Label fx:id="stock"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Cantidad"/>
            <Spinner fx:id="spinnerCantidad" prefWidth="100"/>
        </HBox>

        <Label fx:id="mensajeError" styleClass="mensaje-error" wrapText="true"/>
        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cerrar" onAction="#cerrar" cancelButton="true"/>
            <Button fx:id="botonAgregar" text="Agregar al carrito" onAction="#agregar" styleClass="accent"/>
        </HBox>
    </VBox>
</HBox>
