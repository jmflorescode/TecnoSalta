<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tienda.controlador.ConfirmacionController">
    <top>
        <fx:include source="barra.fxml"/>
    </top>
    <center>
        <VBox spacing="14" styleClass="contenido">
            <Label text="Confirmar compra" styleClass="title-2"/>
            <Label text="Revisar el pedido antes de confirmar. La compra es simulada: no se cobra nada."
                   styleClass="text-muted"/>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="El carrito está vacío."/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="420"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="130"/>
                    <TableColumn fx:id="colPrecio" text="Precio unitario" prefWidth="170"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="170"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="total" styleClass="title-3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Volver al carrito" onAction="#volver"/>
                <Button fx:id="botonConfirmar" text="Confirmar compra" onAction="#confirmar" styleClass="accent"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
