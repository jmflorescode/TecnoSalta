<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tienda.controlador.RegistroController" styleClass="fondo">
    <VBox maxWidth="360" maxHeight="-Infinity" spacing="10" styleClass="panel">
        <Label text="Crear cuenta" styleClass="title-1"/>
        <Label text="TECNOSALTA · Componentes de PC" styleClass="text-muted"/>

        <Label text="Nombre"/>
        <TextField fx:id="campoNombre"/>

        <Label text="Email"/>
        <TextField fx:id="campoEmail" promptText="nombre@correo.com"/>

        <Label text="Contraseña (mínimo 6 caracteres)"/>
        <PasswordField fx:id="campoClave"/>

        <Label text="Repetir contraseña"/>
        <PasswordField fx:id="campoClaveRepetida"/>

        <Label fx:id="mensajeError" styleClass="mensaje-error" wrapText="true"/>

        <Button text="Crear cuenta" onAction="#registrar" defaultButton="true" maxWidth="Infinity" styleClass="accent"/>
        <Hyperlink text="Ya tengo una cuenta" onAction="#irALogin"/>
    </VBox>
</StackPane>
