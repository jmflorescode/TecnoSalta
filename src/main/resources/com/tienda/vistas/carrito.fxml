<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tienda.controlador.CarritoController">
    <top>
        <fx:include fx:id="barra" source="barra.fxml"/>
    </top>
    <center>
        <VBox spacing="14" styleClass="contenido">
            <Label text="Carrito" styleClass="title-2"/>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="El carrito está vacío."/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="380"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="140"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="150" sortable="false"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="150"/>
                    <TableColumn fx:id="colQuitar" prefWidth="120" sortable="false"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="total" styleClass="title-3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Seguir comprando" onAction="#irACatalogo"/>
                <Button fx:id="botonContinuar" text="Continuar" onAction="#continuar" styleClass="accent"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
