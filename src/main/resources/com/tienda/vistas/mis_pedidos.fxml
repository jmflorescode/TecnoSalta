<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tienda.controlador.MisPedidosController">
    <top>
        <fx:include source="barra.fxml"/>
    </top>
    <center>
        <VBox spacing="14" styleClass="contenido">
            <Label text="Mis pedidos" styleClass="title-2"/>

            <TableView fx:id="tablaPedidos" prefHeight="200" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Todavía no hay pedidos."/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNumero" text="N.º" prefWidth="90"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="220"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="180"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="180"/>
                </columns>
            </TableView>

            <Label fx:id="tituloDetalle" text="Seleccionar un pedido para ver su detalle" styleClass="text-muted"/>

            <TableView fx:id="tablaDetalles" prefHeight="200" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Sin pedido seleccionado."/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="420"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="130"/>
                    <TableColumn fx:id="colPrecio" text="Precio pagado" prefWidth="170"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="170"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
