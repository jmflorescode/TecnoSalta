<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tienda.controlador.AdminController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="barra">
            <Label text="TECNOSALTA · Panel de administrador" styleClass="title-3"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botonTema" text="Modo oscuro" onAction="#cambiarTema" styleClass="flat"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ============ Productos ============ -->
            <Tab text="Productos">
                <HBox spacing="16" styleClass="contenido">
                    <TableView fx:id="tablaProductos" HBox.hgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colProdNombre" text="Nombre" prefWidth="330"/>
                            <TableColumn fx:id="colProdCategoria" text="Categoría" prefWidth="130"/>
                            <TableColumn fx:id="colProdPrecio" text="Precio" prefWidth="110"/>
                            <TableColumn fx:id="colProdStock" text="Stock" prefWidth="60"/>
                            <TableColumn fx:id="colProdActivo" text="Visible" prefWidth="60"/>
                        </columns>
                    </TableView>

                    <!-- Si la pantalla es chica, los campos se desplazan; el título y los botones quedan siempre a la vista -->
                    <VBox spacing="10" minWidth="350" prefWidth="350" styleClass="formulario">
                        <Label fx:id="tituloProducto" text="Producto nuevo" styleClass="title-4"/>

                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="panel-scroll">
                        <VBox spacing="6">
                        <Label text="Nombre"/>
                        <TextField fx:id="campoNombre"/>

                        <Label text="Descripción"/>
                        <TextArea fx:id="campoDescripcion" prefRowCount="2" minHeight="60" wrapText="true"/>

                        <HBox spacing="10">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Precio"/>
                                <TextField fx:id="campoPrecio"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Stock"/>
                                <TextField fx:id="campoStock"/>
                            </VBox>
                        </HBox>

                        <Label text="Categoría"/>
                        <ComboBox fx:id="comboCategoria" maxWidth="Infinity"/>

                        <Label text="Imagen"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Elegir imagen…" onAction="#elegirImagen"/>
                            <Label fx:id="etiquetaImagen" text="Sin imagen" styleClass="text-muted"/>
                        </HBox>

                        <CheckBox fx:id="checkActivo" text="Visible en el catálogo" selected="true"/>
                        </VBox>
                        </ScrollPane>

                        <Label fx:id="mensajeProducto" wrapText="true"/>

                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button text="Nuevo" onAction="#nuevoProducto"/>
                            <Button text="Dar de baja" onAction="#darDeBajaProducto" styleClass="danger"/>
                            <Button text="Guardar" onAction="#guardarProducto" styleClass="accent"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ============ Categorías ============ -->
            <Tab text="Categorías">
                <HBox spacing="16" styleClass="contenido">
                    <ListView fx:id="listaCategorias" HBox.hgrow="ALWAYS"/>

                    <VBox spacing="6" minWidth="350" prefWidth="350" styleClass="formulario">
                        <Label fx:id="tituloCategoria" text="Categoría nueva" styleClass="title-4"/>

                        <Label text="Nombre"/>
                        <TextField fx:id="campoCategoria"/>

                        <Label fx:id="mensajeCategoria" wrapText="true"/>
                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button text="Nueva" onAction="#nuevaCategoria"/>
                            <Button text="Eliminar" onAction="#eliminarCategoria" styleClass="danger"/>
                            <Button text="Guardar" onAction="#guardarCategoria" styleClass="accent"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ============ Pedidos ============ -->
            <Tab text="Pedidos">
                <VBox spacing="12" styleClass="contenido">
                    <TableView fx:id="tablaPedidos" prefHeight="200" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Todavía no hay pedidos."/>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colPedNumero" text="N.º" prefWidth="80"/>
                            <TableColumn fx:id="colPedFecha" text="Fecha" prefWidth="190"/>
                            <TableColumn fx:id="colPedCliente" text="Cliente" prefWidth="300"/>
                            <TableColumn fx:id="colPedEstado" text="Estado" prefWidth="160"/>
                            <TableColumn fx:id="colPedTotal" text="Total" prefWidth="160"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="tituloDetalle" text="Seleccionar un pedido para ver su detalle" styleClass="text-muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="mensajePedido"/>
                        <Label text="Estado"/>
                        <ComboBox fx:id="comboEstado" prefWidth="160"/>
                        <Button text="Cambiar estado" onAction="#cambiarEstado" styleClass="accent"/>
                    </HBox>

                    <TableView fx:id="tablaDetalles" prefHeight="200" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Sin pedido seleccionado."/>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colDetProducto" text="Producto" prefWidth="420"/>
                            <TableColumn fx:id="colDetCantidad" text="Cantidad" prefWidth="130"/>
                            <TableColumn fx:id="colDetPrecio" text="Precio pagado" prefWidth="170"/>
                            <TableColumn fx:id="colDetSubtotal" text="Subtotal" prefWidth="170"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
